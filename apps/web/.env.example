# Preferred GoreeCloud map-data release manifest endpoint.
# When set, Maps starts on its local empty style, validates this manifest, then loads
# the immutable style for the declared release. HTTPS is required outside localhost.
# Leave empty until an approved GoreeCloud map-data delivery service is deployed.
VITE_MAP_DATA_MANIFEST_URL=

# Legacy/manual approved MapLibre style endpoint.
# Used only when VITE_MAP_DATA_MANIFEST_URL is empty.
# Leave empty to use the repository's local privacy-safe empty style.
VITE_MAP_STYLE_URL=

# Same-origin Maps API base path. This must remain a path, not an external origin.
VITE_MAPS_API_BASE_PATH=/api/v1

# Optional GoreeCloud Identity public-client registration.
# Leave issuer/client ID blank to keep Identity sign-in disabled.
# Do not put a client secret in the browser application.
VITE_IDENTITY_ISSUER_URL=
VITE_IDENTITY_CLIENT_ID=
VITE_IDENTITY_REDIRECT_URI=
VITE_IDENTITY_SCOPES=openid profile
