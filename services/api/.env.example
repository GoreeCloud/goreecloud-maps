# Bind address for the Maps API.
MAPS_LISTEN_ADDRESS=:8080

# PostgreSQL/PostGIS connection string for a non-owner runtime role without BYPASSRLS.
MAPS_DATABASE_URL=

# GoreeCloud Identity-compatible OIDC issuer and Maps client ID.
MAPS_OIDC_ISSUER_URL=
MAPS_OIDC_CLIENT_ID=

# Optional server-side provider base URLs. Leave blank to keep the capability disabled.
# These are configuration-controlled origins; the API appends only its fixed /search,
# /reverse, or /route actions and never exposes these URLs to untrusted clients.
MAPS_GEOCODER_BASE_URL=
MAPS_ROUTER_BASE_URL=

# Optional non-secret identifier forwarded to approved providers as X-Client-Id.
MAPS_PROVIDER_CLIENT_ID=
