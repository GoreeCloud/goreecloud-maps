{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoreeCloud Maps map-data release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "generatedAt",
    "stylePath",
    "tileTemplate",
    "minZoom",
    "maxZoom",
    "bounds",
    "attribution",
    "sources",
    "publicGeographicDataOnly"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "stylePath": {
      "type": "string",
      "pattern": "^releases/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/style\\.json$"
    },
    "tileTemplate": {
      "type": "string",
      "pattern": "^releases/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/tiles/\\{z\\}/\\{x\\}/\\{y\\}\\.pbf$"
    },
    "minZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
    "maxZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
    "bounds": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "datasetVersion", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "datasetVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
          "license": { "type": "string", "minLength": 1, "maxLength": 160 },
          "provenance": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "publicGeographicDataOnly": { "const": true }
  }
}
